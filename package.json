{
  "name": "see-pound-coffee-pie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:runner:image": "./scripts/check-runner-image.sh",
    "check:runner:staging": "node scripts/check-runner-staging.mjs https://see-pound-coffee-pie-phase2-staging.chris-c39.workers.dev",
    "check:runner:production": "node scripts/check-runner-staging.mjs https://seepoundcoffeepie.com",
    "check:runner:project:staging": "node scripts/check-runner-project.mjs https://see-pound-coffee-pie-phase2-staging.chris-c39.workers.dev",
    "check:runner:project:production": "node scripts/check-runner-project.mjs https://seepoundcoffeepie.com",
    "check:runner:python-data-tools:staging": "node scripts/check-runner-python-data-tools.mjs https://see-pound-coffee-pie-phase2-staging.chris-c39.workers.dev",
    "check:runner:python-data-tools:production": "node scripts/check-runner-python-data-tools.mjs https://seepoundcoffeepie.com",
    "check:runner:cpp-project:staging": "node scripts/check-runner-cpp-project.mjs https://see-pound-coffee-pie-phase2-staging.chris-c39.workers.dev",
    "check:runner:cpp-project:production": "node scripts/check-runner-cpp-project.mjs https://seepoundcoffeepie.com",
    "check:runner:csharp-project:staging": "node scripts/check-runner-csharp-project.mjs https://see-pound-coffee-pie-phase2-staging.chris-c39.workers.dev",
    "check:runner:csharp-project:production": "node scripts/check-runner-csharp-project.mjs https://seepoundcoffeepie.com",
    "check:runner:java-project:staging": "node scripts/check-runner-java-project.mjs https://see-pound-coffee-pie-phase2-staging.chris-c39.workers.dev",
    "check:runner:java-project:production": "node scripts/check-runner-java-project.mjs https://seepoundcoffeepie.com",
    "check:runner:smoke": "node scripts/check-runner-smoke.mjs https://seepoundcoffeepie.com",
    "check:site:staging": "node scripts/check-staging-site.mjs",
    "check:site:staging:enabled": "node scripts/check-staging-site.mjs --require-enabled",
    "d1:migrate:local": "wrangler d1 migrations apply LEARNER_DB --local",
    "d1:migrate:staging": "wrangler d1 migrations apply LEARNER_DB --remote --config wrangler.staging.jsonc",
    "d1:migrate:production": "wrangler d1 migrations apply LEARNER_DB --remote",
    "deploy": "npm run deploy:site",
    "deploy:site": "npm run check:release && node scripts/deploy-public-site.mjs production",
    "deploy:site:staging": "npm run check:release && node scripts/deploy-public-site.mjs staging",
    "deploy:staging": "npm run deploy:site:staging",
    "deploy:dry-run": "npm run build && node scripts/deploy-public-site.mjs production --dry-run",
    "deploy:staging:dry-run": "npm run build && node scripts/deploy-public-site.mjs staging --dry-run",
    "check:live": "node scripts/check-live.mjs",
    "check:live:paused": "node scripts/check-live.mjs --allow-paused",
    "check:release": "npm test && npm run lint && npm run check:text-style && npm run check:social-preview && npm run build && npm run check:project-bundle && npm run check:public-site-deploy && npm run check:bundle",
    "check:project-bundle": "node scripts/check-project-bundle.mjs",
    "check:public-site-deploy": "node scripts/check-public-site-deploy.mjs",
    "check:social-preview": "node scripts/check-social-preview.mjs",
    "check:text-style": "node scripts/check-text-style.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.7",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
