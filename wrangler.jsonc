{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "see-pound-coffee-pie",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23liVtLemmmdmrUXoi"
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET",
      "SESSION_SECRET"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "seepoundcoffeepie.com",
      "custom_domain": true
    },
    {
      "pattern": "www.seepoundcoffeepie.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
