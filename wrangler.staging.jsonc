{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "see-pound-coffee-pie-phase2-staging",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "RUNNER_ENABLED": "false",
    "RUNNER_ORIGIN": "https://see-pound-coffee-pie-phase2-staging.chris-c39.workers.dev"
  },
  "secrets": {
    "required": ["SESSION_SECRET"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "RUNNER_CONFIG",
      "id": "6bf969696f1a4b39b87fc074d16ab233"
    }
  ],
  "containers": [
    {
      "class_name": "RunnerPythonSandbox",
      "image": "./Dockerfile.runner.python",
      "instance_type": "basic",
      "max_instances": 2
    },
    {
      "class_name": "RunnerCppSandbox",
      "image": "./Dockerfile.runner.cpp",
      "instance_type": "basic",
      "max_instances": 2
    },
    {
      "class_name": "RunnerCsharpSandbox",
      "image": "./Dockerfile.runner.csharp",
      "instance_type": "basic",
      "max_instances": 2
    },
    {
      "class_name": "RunnerJavaSandbox",
      "image": "./Dockerfile.runner.java",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNNER_PYTHON",
        "class_name": "RunnerPythonSandbox"
      },
      {
        "name": "RUNNER_CPP",
        "class_name": "RunnerCppSandbox"
      },
      {
        "name": "RUNNER_CSHARP",
        "class_name": "RunnerCsharpSandbox"
      },
      {
        "name": "RUNNER_JAVA",
        "class_name": "RunnerJavaSandbox"
      },
      {
        "name": "RUNNER_CONTROL",
        "class_name": "RunnerCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "runner-v1",
      "new_sqlite_classes": ["RunnerSandbox", "RunnerCoordinator"]
    },
    {
      "tag": "runner-v2-language-images",
      "new_sqlite_classes": ["RunnerPythonSandbox", "RunnerCppSandbox", "RunnerCsharpSandbox", "RunnerJavaSandbox"],
      "deleted_classes": ["RunnerSandbox"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
